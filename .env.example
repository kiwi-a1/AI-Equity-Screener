# Copy to .env.local for local runs. On Vercel, add these under Project Settings > Environment Variables.
# The AI analyst needs ONE of these keys (Claude is used if both are set).
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: improves the news feed (free key from finnhub.io)
FINNHUB_API_KEY=
# Optional overrides
# GEMINI_MODEL=gemini-flash-latest
# ANALYST_MODEL=claude-opus-5-5
# ANALYST_EFFORT=medium
# BENCHMARK_SYMBOL=^GSPC
# DATA_PROVIDER=mock   (synthetic data for offline testing only)
